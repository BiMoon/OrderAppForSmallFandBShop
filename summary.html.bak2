<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#ffffff">
<title>Thống Kê Pha Chế</title>
<style>
  :root{
    --bg:#f6f7f9; --surface:#fff; --surface-2:#fbfbfc;
    --line:#e6e8ec; --line-strong:#d5d9e0;
    --ink:#16191f; --ink-2:#5b6472; --ink-3:#8c95a4;
    --brand:#0f766e; --brand-soft:#e6f4f1; --brand-2:#0d9488;
    --ok:#16a34a; --warn:#b45309; --late:#c02626;
    --radius:14px;
    --shadow-1:0 1px 2px rgba(16,24,40,.05),0 1px 3px rgba(16,24,40,.06);
    --shadow-2:0 4px 12px rgba(16,24,40,.08),0 2px 4px rgba(16,24,40,.04);
  }
  *{box-sizing:border-box}
  body{
    margin:0;background:var(--bg);color:var(--ink);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
    font-size:16px;-webkit-font-smoothing:antialiased;
  }
  button,input,select{font-family:inherit}

  /* ---------- header ---------- */
  .topbar{
    position:sticky;top:0;z-index:50;height:72px;
    display:flex;align-items:center;gap:16px;padding:0 22px;
    background:rgba(255,255,255,.88);
    backdrop-filter:saturate(180%) blur(12px);-webkit-backdrop-filter:saturate(180%) blur(12px);
    border-bottom:1px solid var(--line);
  }
  .brand{display:flex;align-items:center;gap:12px}
  .brand-mark{width:40px;height:40px;border-radius:11px;background:var(--brand);color:#fff;display:grid;place-items:center;font-size:19px}
  .brand-title{font-size:15px;font-weight:700;letter-spacing:-.01em;line-height:1.2}
  .brand-sub{font-size:12px;color:var(--ink-3);margin-top:1px}
  .spacer{flex:1}
  .sync{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;font-weight:600;color:var(--ink-2)}
  .dot{width:8px;height:8px;border-radius:50%;background:var(--ink-3)}
  .sync.online .dot{background:var(--ok);box-shadow:0 0 0 3px #e9f7ee}
  .sync.offline .dot{background:var(--late);box-shadow:0 0 0 3px #fdecec}
  .btn{
    height:40px;padding:0 14px;display:inline-flex;align-items:center;gap:7px;
    border:1px solid var(--line-strong);background:var(--surface);border-radius:10px;
    cursor:pointer;font-size:13.5px;font-weight:600;color:var(--ink-2);transition:.15s;white-space:nowrap;
  }
  .btn:hover{background:var(--surface-2);border-color:var(--ink-3)}
  .btn-primary{background:var(--ink);border-color:var(--ink);color:#fff}
  .btn-primary:hover{background:var(--brand);border-color:var(--brand);color:#fff}

  /* ---------- filter bar ---------- */
  .filterbar{
    display:flex;align-items:center;gap:10px;flex-wrap:wrap;
    padding:14px 22px;background:var(--surface);border-bottom:1px solid var(--line);
  }
  .fl-label{font-size:12px;font-weight:600;color:var(--ink-3);text-transform:uppercase;letter-spacing:.06em}
  .seg{display:inline-flex;background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:3px;gap:2px;flex-wrap:wrap}
  .seg button{border:0;background:transparent;cursor:pointer;padding:7px 14px;border-radius:8px;font-size:13.5px;font-weight:600;color:var(--ink-2);transition:.15s}
  .seg button.active{background:var(--surface);color:var(--ink);box-shadow:var(--shadow-1)}
  .range{display:none;align-items:center;gap:8px}
  .range.show{display:inline-flex}
  input[type=date]{
    height:38px;padding:0 11px;border:1px solid var(--line-strong);border-radius:9px;
    background:var(--surface);font-size:13.5px;color:var(--ink);
  }
  .search{
    height:38px;padding:0 12px 0 34px;min-width:210px;
    border:1px solid var(--line-strong);border-radius:9px;background:var(--surface) ;
    font-size:14px;color:var(--ink);
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%238c95a4' stroke-width='2.2' stroke-linecap='round'><circle cx='11' cy='11' r='7'/><path d='M20 20l-3.6-3.6'/></svg>");
    background-repeat:no-repeat;background-position:11px center;
  }
  .search:focus{outline:0;border-color:var(--brand);box-shadow:0 0 0 3px var(--brand-soft)}

  /* ---------- layout ---------- */
  .wrap{padding:22px;max-width:1440px;margin:0 auto}
  .range-caption{font-size:13px;color:var(--ink-3);margin:-4px 0 16px;font-weight:500}

  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px;margin-bottom:20px}
  .kpi{
    background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);
    padding:16px 18px;box-shadow:var(--shadow-1);position:relative;overflow:hidden;
  }
  .kpi-lbl{font-size:11.5px;font-weight:600;color:var(--ink-3);text-transform:uppercase;letter-spacing:.06em}
  .kpi-val{font-size:32px;font-weight:700;letter-spacing:-.025em;line-height:1.1;margin-top:7px;font-variant-numeric:tabular-nums}
  .kpi-val .u{font-size:14px;font-weight:600;color:var(--ink-3);letter-spacing:0;margin-left:4px}
  .kpi-sub{font-size:12.5px;color:var(--ink-2);margin-top:6px;line-height:1.35;
           white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .kpi.accent{background:var(--brand);border-color:var(--brand)}
  .kpi.accent .kpi-lbl{color:rgba(255,255,255,.72)}
  .kpi.accent .kpi-val{color:#fff}
  .kpi.accent .kpi-val .u{color:rgba(255,255,255,.72)}
  .kpi.accent .kpi-sub{color:rgba(255,255,255,.82)}

  .cols{display:grid;grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:16px;align-items:start}
  @media (max-width:1080px){.cols{grid-template-columns:1fr}}

  .card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow-1);overflow:hidden}
  .card-head{display:flex;align-items:center;gap:10px;padding:15px 18px;border-bottom:1px solid var(--line)}
  .card-title{font-size:14.5px;font-weight:700;letter-spacing:-.01em}
  .card-note{font-size:12px;color:var(--ink-3);font-weight:500}
  .card-body{padding:16px 18px}

  /* ---------- table ---------- */
  table{width:100%;border-collapse:collapse}
  thead th{
    font-size:11.5px;font-weight:600;color:var(--ink-3);text-transform:uppercase;letter-spacing:.05em;
    text-align:left;padding:11px 18px;background:var(--surface-2);border-bottom:1px solid var(--line);
    white-space:nowrap;cursor:pointer;user-select:none;
  }
  thead th:hover{color:var(--ink)}
  thead th .ar{opacity:.35;font-size:10px;margin-left:3px}
  thead th.sorted .ar{opacity:1;color:var(--brand)}
  th.num,td.num{text-align:right}
  tbody td{padding:12px 18px;border-bottom:1px solid var(--line);font-size:14.5px;vertical-align:middle}
  tbody tr:last-child td{border-bottom:0}
  tbody tr:hover{background:var(--surface-2)}
  .rank{
    width:26px;height:26px;border-radius:8px;display:grid;place-items:center;
    font-size:12px;font-weight:700;background:var(--bg);color:var(--ink-2);
    font-variant-numeric:tabular-nums;
  }
  tbody tr:nth-child(1) .rank{background:var(--brand);color:#fff}
  tbody tr:nth-child(2) .rank{background:var(--brand-soft);color:var(--brand)}
  tbody tr:nth-child(3) .rank{background:var(--brand-soft);color:var(--brand)}
  .item-name{font-weight:600;letter-spacing:-.005em}
  .qty{font-weight:700;font-variant-numeric:tabular-nums;font-size:15.5px}
  .share{display:flex;align-items:center;gap:10px;min-width:150px}
  .bar{flex:1;height:7px;background:var(--bg);border-radius:99px;overflow:hidden}
  .bar i{display:block;height:100%;background:var(--brand-2);border-radius:99px;transition:width .5s cubic-bezier(.2,.8,.3,1)}
  .share span{font-size:12.5px;color:var(--ink-2);font-variant-numeric:tabular-nums;width:44px;text-align:right;font-weight:600}

  /* ---------- daily chart ---------- */
  .chart{display:flex;align-items:flex-end;gap:5px;height:172px;padding-top:8px}
  .col{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:6px;min-width:0;position:relative}
  .col i{
    display:block;width:100%;max-width:38px;background:var(--brand-2);border-radius:5px 5px 0 0;
    min-height:3px;transition:.4s;cursor:default;
  }
  .col:hover i{background:var(--ink)}
  .col em{font-size:10.5px;color:var(--ink-3);font-style:normal;white-space:nowrap;font-variant-numeric:tabular-nums}
  .col b{position:absolute;top:-2px;font-size:11px;font-weight:700;color:var(--ink-2);font-variant-numeric:tabular-nums}

  /* ---------- misc ---------- */
  .empty{text-align:center;padding:64px 20px;color:var(--ink-3)}
  .empty-icon{width:68px;height:68px;margin:0 auto 16px;border-radius:20px;background:var(--bg);display:grid;place-items:center;font-size:30px}
  .empty h3{margin:0 0 5px;font-size:16px;font-weight:700;color:var(--ink-2)}
  .empty p{margin:0;font-size:13.5px}
  .skeleton{height:14px;border-radius:6px;background:linear-gradient(90deg,#eef0f3 25%,#f6f7f9 50%,#eef0f3 75%);background-size:200% 100%;animation:sh 1.2s infinite}
  @keyframes sh{0%{background-position:200% 0}100%{background-position:-200% 0}}
  .toast{
    position:fixed;left:50%;bottom:26px;transform:translate(-50%,20px);
    background:var(--ink);color:#fff;padding:11px 20px;border-radius:10px;
    font-size:14px;font-weight:600;box-shadow:var(--shadow-2);
    opacity:0;pointer-events:none;transition:.25s;z-index:80;
  }
  .toast.show{opacity:1;transform:translate(-50%,0)}
  .toast.err{background:var(--late)}

  @media (max-width:640px){
    .brand-sub{display:none}
    .topbar,.filterbar,.wrap{padding-left:14px;padding-right:14px}
    thead th,tbody td{padding-left:12px;padding-right:12px}
    .col em{display:none}
  }
  @media print{
    .topbar,.filterbar,.btn{display:none!important}
    body{background:#fff}
    .card,.kpi{box-shadow:none;break-inside:avoid}
  }
</style>
</head>
<body>

<header class="topbar">
  <div class="brand">
    <div class="brand-mark">📊</div>
    <div>
      <div class="brand-title">Thống Kê Pha Chế</div>
      <div class="brand-sub">Báo cáo sản lượng &amp; món bán chạy</div>
    </div>
  </div>
  <div class="spacer"></div>
  <div class="sync" id="sync"><span class="dot"></span><span id="syncTxt">Đang tải…</span></div>
  <button class="btn" id="btnPrint">🖨️ In</button>
  <button class="btn btn-primary" id="btnCsv">⬇ Xuất CSV</button>
</header>

<div class="filterbar">
  <span class="fl-label">Kỳ báo cáo</span>
  <div class="seg" id="segRange">
    <button data-r="today" class="active">Hôm nay</button>
    <button data-r="yesterday">Hôm qua</button>
    <button data-r="7d">7 ngày</button>
    <button data-r="month">Tháng này</button>
    <button data-r="all">Tất cả</button>
    <button data-r="custom">Tùy chọn</button>
  </div>
  <div class="range" id="rangeInputs">
    <input type="date" id="dFrom"> <span style="color:var(--ink-3);font-size:13px">→</span> <input type="date" id="dTo">
  </div>
  <div class="spacer"></div>
  <input class="search" id="q" type="search" placeholder="Tìm tên món…" autocomplete="off">
</div>

<main class="wrap">
  <div class="range-caption" id="caption">&nbsp;</div>

  <section class="kpis">
    <div class="kpi accent">
      <div class="kpi-lbl">Tổng sản lượng</div>
      <div class="kpi-val"><span id="kTotal">–</span><span class="u">ly</span></div>
      <div class="kpi-sub" id="kTotalSub">&nbsp;</div>
    </div>
    <div class="kpi">
      <div class="kpi-lbl">Món bán chạy nhất</div>
      <div class="kpi-val" style="font-size:21px" id="kTop">–</div>
      <div class="kpi-sub" id="kTopSub">&nbsp;</div>
    </div>
    <div class="kpi">
      <div class="kpi-lbl">Số loại món</div>
      <div class="kpi-val"><span id="kKinds">–</span><span class="u">món</span></div>
      <div class="kpi-sub" id="kKindsSub">&nbsp;</div>
    </div>
    <div class="kpi">
      <div class="kpi-lbl">Trung bình / ngày</div>
      <div class="kpi-val"><span id="kAvg">–</span><span class="u">ly</span></div>
      <div class="kpi-sub" id="kAvgSub">&nbsp;</div>
    </div>
  </section>

  <div class="cols">
    <section class="card">
      <div class="card-head">
        <span class="card-title">Chi tiết theo món</span>
        <span class="card-note" id="tblNote"></span>
      </div>
      <table>
        <thead>
          <tr>
            <th style="width:52px">#</th>
            <th data-s="name">Tên món <span class="ar">▾</span></th>
            <th data-s="qty" class="num sorted">Số lượng <span class="ar">▾</span></th>
            <th data-s="qty" style="width:180px">Tỷ trọng</th>
          </tr>
        </thead>
        <tbody id="tbody">
          <tr><td colspan="4"><div class="skeleton" style="width:60%"></div></td></tr>
        </tbody>
      </table>
    </section>

    <section class="card">
      <div class="card-head">
        <span class="card-title">Sản lượng theo ngày</span>
        <span class="card-note" id="chartNote"></span>
      </div>
      <div class="card-body"><div class="chart" id="chart"></div></div>
    </section>
  </div>
</main>

<div class="toast" id="toast"></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
import { getDatabase, ref, onValue } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

const firebaseConfig = {
  apiKey: "AIzaSyAWgDT99kbQlTzOG76xVImqtu3tRGPfstI",
  authDomain: "quanlyphachequan.firebaseapp.com",
  databaseURL: "https://quanlyphachequan-default-rtdb.asia-southeast1.firebasedatabase.app",
  projectId: "quanlyphachequan",
  storageBucket: "quanlyphachequan.firebasestorage.app",
  messagingSenderId: "522540933651",
  appId: "1:522540933651:web:acbe8224f1db47b2d895e6"
};
const app = initializeApp(firebaseConfig);
const db  = getDatabase(app);

const $ = id => document.getElementById(id);
const esc = s => String(s ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const nf = new Intl.NumberFormat('vi-VN');

/* local (không phải UTC) YYYY-MM-DD — tránh lệch ngày do múi giờ +07 */
function ymd(d){
  return d.getFullYear() + '-' +
         String(d.getMonth()+1).padStart(2,'0') + '-' +
         String(d.getDate()).padStart(2,'0');
}
const addDays = (d,n)=>{const x=new Date(d);x.setDate(x.getDate()+n);return x;};
const dmy = s => s ? s.slice(8,10)+'/'+s.slice(5,7) : '';

/* ---------- state ---------- */
let rows = [];               // [{item, qty, date, table}]
let range = 'today';
let sortKey = 'qty', sortDir = -1;
let query = '';

/* ---------- normalise a history record ---------- */
// Ưu tiên completedDate (do KDS ghi), fallback data.date (bản cũ),
// cuối cùng suy ra từ timestamp theo giờ địa phương.
function normalise(d){
  let date = d.completedDate || d.date || null;
  if (!date && typeof d.timestamp === 'number') date = ymd(new Date(d.timestamp));
  return {
    item : String(d.item ?? '(không tên)'),
    qty  : Number(d.quantity) || 0,
    date : date,
    table: d.table ?? null
  };
}

/* ---------- date range resolution ---------- */
function resolveRange(){
  const today = new Date();
  switch(range){
    case 'today':     return [ymd(today), ymd(today)];
    case 'yesterday': { const y = addDays(today,-1); return [ymd(y), ymd(y)]; }
    case '7d':        return [ymd(addDays(today,-6)), ymd(today)];
    case 'month':     return [ymd(today).slice(0,8)+'01', ymd(today)];
    case 'all':       return [null, null];
    case 'custom':    return [$('dFrom').value || null, $('dTo').value || null];
  }
}
function captionFor(from,to){
  if (!from && !to) return 'Toàn bộ dữ liệu lịch sử';
  if (from === to)  return 'Ngày ' + dmy(from) + '/' + from.slice(0,4);
  return 'Từ ' + dmy(from) + ' đến ' + dmy(to) + '/' + (to||from).slice(0,4);
}

/* ---------- main render ---------- */
function render(){
  const [from,to] = resolveRange();
  $('caption').textContent = captionFor(from,to);

  const inRange = rows.filter(r => {
    if (!r.date) return !from && !to;      // bản ghi thiếu ngày chỉ hiện ở "Tất cả"
    if (from && r.date < from) return false;
    if (to   && r.date > to)   return false;
    return true;
  });

  // gộp theo tên món
  const byItem = new Map();
  inRange.forEach(r => byItem.set(r.item, (byItem.get(r.item)||0) + r.qty));

  const total  = [...byItem.values()].reduce((a,b)=>a+b,0);
  const days   = new Set(inRange.map(r=>r.date).filter(Boolean));
  const sorted = [...byItem.entries()].sort((a,b)=>b[1]-a[1]);
  const top    = sorted[0];

  /* KPI */
  $('kTotal').textContent = nf.format(total);
  $('kTotalSub').textContent = inRange.length
    ? nf.format(inRange.length) + ' lượt pha · ' + days.size + ' ngày có dữ liệu'
    : 'Chưa có lượt pha nào';
  $('kTop').textContent    = top ? top[0] : '–';
  $('kTopSub').textContent = top
    ? nf.format(top[1]) + ' ly · chiếm ' + (top[1]/total*100).toFixed(1) + '%'
    : ' ';
  $('kKinds').textContent   = byItem.size;
  $('kKindsSub').textContent = byItem.size
    ? 'Trung bình ' + (total/byItem.size).toFixed(1) + ' ly / món'
    : ' ';
  const avg = days.size ? total/days.size : 0;
  $('kAvg').textContent    = days.size ? avg.toFixed(avg >= 10 ? 0 : 1) : '–';
  $('kAvgSub').textContent = days.size ? 'Tính trên ' + days.size + ' ngày có bán' : ' ';

  /* bảng */
  let list = sorted.map(([item,qty]) => ({item,qty}));
  if (query) list = list.filter(r => r.item.toLowerCase().includes(query));
  list.sort((a,b) => sortKey === 'name'
    ? a.item.localeCompare(b.item,'vi') * sortDir * -1
    : (a.qty - b.qty) * sortDir);

  const max = Math.max(1, ...list.map(r=>r.qty));
  $('tblNote').textContent = list.length
    ? list.length + ' món' + (query ? ' khớp tìm kiếm' : '')
    : '';

  $('tbody').innerHTML = list.length ? list.map((r,i) => `
    <tr>
      <td><span class="rank">${i+1}</span></td>
      <td class="item-name">${esc(r.item)}</td>
      <td class="num qty">${nf.format(r.qty)}</td>
      <td><div class="share">
        <div class="bar"><i style="width:${(r.qty/max*100).toFixed(1)}%"></i></div>
        <span>${total ? (r.qty/total*100).toFixed(1) : '0.0'}%</span>
      </div></td>
    </tr>`).join('')
    : `<tr><td colspan="4"><div class="empty">
        <div class="empty-icon">${query ? '🔍' : '📭'}</div>
        <h3>${query ? 'Không tìm thấy món nào' : 'Chưa có dữ liệu trong kỳ này'}</h3>
        <p>${query ? 'Thử từ khóa khác.' : 'Món được ghi nhận khi bấm “Hoàn thành” ở màn hình pha chế.'}</p>
      </div></td></tr>`;

  /* biểu đồ ngày */
  const byDay = new Map();
  inRange.forEach(r => { if (r.date) byDay.set(r.date, (byDay.get(r.date)||0) + r.qty); });
  let dayKeys = [...byDay.keys()].sort();
  if (dayKeys.length > 31) dayKeys = dayKeys.slice(-31);
  const dMax = Math.max(1, ...dayKeys.map(k=>byDay.get(k)));
  $('chartNote').textContent = dayKeys.length ? dayKeys.length + ' ngày' : '';
  $('chart').innerHTML = dayKeys.length
    ? dayKeys.map(k => {
        const v = byDay.get(k);
        return `<div class="col" title="${dmy(k)}: ${nf.format(v)} ly">
                  <b>${v}</b><i style="height:${Math.max(4,(v/dMax*128)).toFixed(0)}px"></i><em>${dmy(k)}</em>
                </div>`;
      }).join('')
    : `<div class="empty" style="margin:auto;padding:24px">
         <div class="empty-icon" style="width:52px;height:52px;font-size:24px">📈</div>
         <p>Chưa có dữ liệu để vẽ</p></div>`;

  window.__export = { list, total, from, to };
}

/* ---------- events ---------- */
$('segRange').onclick = e => {
  const b = e.target.closest('button[data-r]'); if (!b) return;
  range = b.dataset.r;
  [...e.currentTarget.children].forEach(x => x.classList.toggle('active', x===b));
  $('rangeInputs').classList.toggle('show', range === 'custom');
  render();
};
$('dFrom').onchange = $('dTo').onchange = render;
$('q').oninput = e => { query = e.target.value.trim().toLowerCase(); render(); };

document.querySelectorAll('thead th[data-s]').forEach(th => {
  th.onclick = () => {
    const k = th.dataset.s;
    if (k === sortKey) sortDir *= -1; else { sortKey = k; sortDir = -1; }
    document.querySelectorAll('thead th').forEach(x => x.classList.remove('sorted'));
    th.classList.add('sorted');
    th.querySelector('.ar').textContent = sortDir === -1 ? '▾' : '▴';
    render();
  };
});

$('btnPrint').onclick = () => window.print();

$('btnCsv').onclick = () => {
  const {list,total,from,to} = window.__export || {};
  if (!list || !list.length) return toast('Không có dữ liệu để xuất', true);
  const lines = [
    ['Ky bao cao', captionFor(from,to)].join(','),
    '',
    ['Hang','Ten mon','So luong (ly)','Ty trong (%)'].join(','),
    ...list.map((r,i) => [i+1, `"${r.item.replace(/"/g,'""')}"`, r.qty,
                          total ? (r.qty/total*100).toFixed(1) : '0.0'].join(',')),
    '', ['','TONG CONG', total, '100.0'].join(',')
  ];
  const blob = new Blob(['﻿' + lines.join('\r\n')], {type:'text/csv;charset=utf-8;'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `thongke-phache-${from||'all'}${to&&to!==from?'_'+to:''}.csv`;
  a.click(); URL.revokeObjectURL(a.href);
  toast('Đã xuất ' + list.length + ' dòng');
};

function toast(msg, err){
  const t = $('toast');
  t.textContent = msg;
  t.className = 'toast show' + (err ? ' err' : '');
  clearTimeout(t._h); t._h = setTimeout(()=>t.className='toast', 2600);
}

/* ---------- data (live) ---------- */
const today = new Date();
$('dFrom').value = ymd(addDays(today,-6));
$('dTo').value   = ymd(today);

onValue(ref(db,'.info/connected'), s => {
  const on = s.val() === true;
  $('sync').className = 'sync ' + (on ? 'online' : 'offline');
  if (!on) $('syncTxt').textContent = 'Mất kết nối';
});

onValue(ref(db,'history'), snap => {
  rows = [];
  snap.forEach(c => { rows.push(normalise(c.val() || {})); });
  const n = new Date();
  $('syncTxt').textContent = 'Cập nhật ' +
    String(n.getHours()).padStart(2,'0') + ':' + String(n.getMinutes()).padStart(2,'0');
  $('sync').classList.add('online');
  render();
}, err => {
  console.error(err);
  $('sync').className = 'sync offline';
  $('syncTxt').textContent = 'Lỗi tải dữ liệu';
  toast('Không tải được lịch sử — kiểm tra quyền đọc (.read)', true);
});

render();
</script>
</body>
</html>
